{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/acknowledgment-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/av-scan-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}